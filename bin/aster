#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="$PWD/.venv/bin:$PATH"
export PATH="$PWD/.aster-bin:$PATH"

run() {
    if [ -f .env ]; then
        exec python -m dotenv -f .env run --no-override -- "$@"
    fi
    exec "$@"
}

case "${1:-help}" in
  serve)
    run python -m aster serve -c tutorials/evolve-your-harness/configs/deployment.yaml
    ;;
  demo)
    shift
    run bash tutorials/evolve-your-harness/run.sh "$@"
    ;;
  *)
    printf 'Aster Infrastructure\n\n  ./bin/aster serve  Start the persistent harness service\n  ./bin/aster demo   Run the configured harness tutorial\n\nSee ASTER.md for configuration and attribution.\n'
    ;;
esac
